{
	"name": "HideSensitive",
	"version": "1.0.0",
	"author": "BZPN",
	"url": "https://www.mediawiki.org/wiki/Extension:HideSensitive",
	"descriptionmsg": "hidesensitive-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"manifest_version": 2,
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"MessagesDirs": {
		"HideSensitive": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\HideSensitive\\": "src/"
	},
	"config": {
		"SensitiveContentAllowedGroup": {
			"value": []
		},
		"SensitiveButtonText": {
			"value": "Show"
		},
		"SensitiveButtonColor": {
			"value": "#36c"
		},
		"SensitiveInfoPage": {
			"value": "Help:Sensitive_content"
		}
	},
	"Hooks": {
		"ThumbnailBeforeProduceHTML": "MediaWiki\\Extension\\HideSensitive\\Hooks::onThumbnailBeforeProduceHTML",
		"ImagePageFindFile": "MediaWiki\\Extension\\HideSensitive\\Hooks::onImagePageFindFile",
		"ResourceLoaderGetConfigVars": "MediaWiki\\Extension\\HideSensitive\\Hooks::onResourceLoaderGetConfigVars"
	},
	"ResourceModules": {
		"ext.hideSensitive.core": {
			"class": "MediaWiki\\ResourceLoader\\FileModule",
			"scripts": [
				"resources/ext.hideSensitive.core.js"
			],
			"styles": [
				"resources/ext.hideSensitive.core.css"
			],
			"messages": [
				"hidesensitive-default-description",
				"hidesensitive-learn-more",
				"hidesensitive-button-text"
			],
			"images": [
				"resources/images/icon.png",
				"resources/images/info.png"
			],
			"dependencies": [
				"mediawiki.util",
				"mediawiki.api"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "HideSensitive"
	}
}
