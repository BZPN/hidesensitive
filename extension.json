{
	"name": "HideSensitive",
	"version": "1.0.0",
	"author": "BZPN",
	"url": "https://www.mediawiki.org/wiki/Extension:HideSensitive",
	"descriptionmsg": "hidesensitive-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"manifest_version": 2,
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"MessagesDirs": {
		"HideSensitive": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\HideSensitive\\": "src/"
	},
	"Config": {
		"SensitiveContentAllowedGroup": {
			"value": []
		},
		"SensitiveDefaultDescription": {
			"value": "This content has been marked as sensitive."
		},
		"SensitiveButtonText": {
			"value": "Show"
		},
		"SensitiveButtonColor": {
			"value": "#36c"
		},
		"SensitiveAllowedUsers": {
			"value": []
		},
		"SensitiveAllowedNamespaces": {
			"value": []
		}
	},
	"Hooks": {
		"ThumbnailBeforeProduceHTML": "HideSensitiveHooks",
		"ImageBeforeProduceHTML": "HideSensitiveHooks",
		"ImageOpenShowImageInlineBefore": "HideSensitiveHooks",
		"BeforePageDisplay": "HideSensitiveHooks",
		"ResourceLoaderGetConfigVars": "HideSensitiveHooks"
	},
	"HookHandlers": {
		"HideSensitiveHooks": {
			"class": "MediaWiki\\Extension\\HideSensitive\\Hooks"
		}
	},
	"ResourceModules": {
		"ext.hideSensitive.core": {
			"class": "ResourceLoader\\FileModule",
			"scripts": [
				"resources/ext.hideSensitive.core.js"
			],
			"styles": [
				"resources/ext.hideSensitive.core.css"
			],
			"messages": [
				"hidesensitive-default-description",
				"hidesensitive-button-text"
			],
			"dependencies": [
				"mediawiki.util",
				"mediawiki.api"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "HideSensitive"
	}
}
